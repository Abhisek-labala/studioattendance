# Studio GFX Photography — Environment Configuration

# PostgreSQL Connection String (Native pg Pool)
# Local development format: postgresql://postgres:postgres@localhost:5432/studio_gfx
# Production remote host format: postgresql://studio_app:SecurePasswordHere@db.yourdomain.com:5432/studio_gfx?sslmode=require
DATABASE_URL=postgresql://APP_USER:YOUR_PASSWORD@YOUR_DB_HOST:5432/YOUR_DATABASE

# Node Environment ('development' | 'production')
NODE_ENV=development

# Server-side Session Secret (Minimum 32 random characters)
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# Public URL of the Application
APP_URL=http://localhost:3000

# Optional Database Pool Fine-Tuning
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

